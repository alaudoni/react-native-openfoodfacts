{
  "name": "react-native-openfoodfacts",
  "version": "0.2.0",
  "description": "React Native hooks and client for the official Open Food Facts JavaScript SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs/sdk-compatibility.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alaudoni/react-native-openfoodfacts.git"
  },
  "homepage": "https://github.com/alaudoni/react-native-openfoodfacts#readme",
  "bugs": {
    "url": "https://github.com/alaudoni/react-native-openfoodfacts/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "version": "npm run build",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "react-native",
    "openfoodfacts",
    "food",
    "expo",
    "react-query"
  ],
  "author": "Andrea Laudoni",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "dependencies": {
    "@openfoodfacts/openfoodfacts-nodejs": "2.0.0-alpha.35"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "typescript": "^5.9.2",
    "react": "19.1.0",
    "@tanstack/react-query": "^5.84.1"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "@tanstack/react-query": "^5.84.1"
  }
}
